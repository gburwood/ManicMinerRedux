{
  "required": [
    "id",
    "change",
    "revision",
    "affected",
    "summary"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^IA-[0-9]{4,}-[0-9]{2,}$"
    },
    "change": {
      "type": "string",
      "pattern": "^CHG-[0-9]{4,}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "affected": {
      "type": "object"
    },
    "compatibility": {
      "type": "object"
    },
    "migration": {
      "type": "object"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "open_changes": {
      "type": "object"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "impact-analysis",
  "type": "object",
  "$defs": {
    "actor": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "human",
            "ai",
            "automated_system",
            "external_system",
            "unknown"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string"
        },
        "ai": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "tool": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "session_id": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}