{
  "required": [
    "id",
    "change",
    "proposal",
    "attempt",
    "actor",
    "outcome"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^IMP-[0-9]{4,}-[0-9]{2,}$"
    },
    "change": {
      "type": "string",
      "pattern": "^CHG-[0-9]{4,}$"
    },
    "proposal": {
      "type": "string",
      "pattern": "^PROP-[0-9]{4,}-[0-9]{2,}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "$ref": "#/$defs/actor"
    },
    "approach": {
      "type": "string"
    },
    "source_revision": {
      "type": "object"
    },
    "outcome": {
      "enum": [
        "in_progress",
        "passed",
        "failed",
        "abandoned",
        "superseded"
      ]
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^VAL-[0-9]{4,}$"
      }
    },
    "tests": {
      "type": "object"
    },
    "failure": {
      "type": "object"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "implementation-attempt",
  "type": "object",
  "$defs": {
    "actor": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "human",
            "ai",
            "automated_system",
            "external_system",
            "unknown"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string"
        },
        "ai": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "tool": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "session_id": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}