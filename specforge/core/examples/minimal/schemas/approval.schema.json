{
  "required": [
    "id",
    "change",
    "proposal",
    "decision",
    "actor",
    "timestamp"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^APR-[0-9]{4,}$"
    },
    "change": {
      "type": "string",
      "pattern": "^CHG-[0-9]{4,}$"
    },
    "proposal": {
      "type": "string",
      "pattern": "^PROP-[0-9]{4,}-[0-9]{2,}$"
    },
    "decision": {
      "enum": [
        "approved",
        "rejected",
        "withdrawn"
      ]
    },
    "actor": {
      "$ref": "#/$defs/actor"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object"
    },
    "mechanism": {
      "type": "object"
    },
    "evidence": {
      "type": "object"
    },
    "comment": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "approval",
  "type": "object",
  "$defs": {
    "actor": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "human",
            "ai",
            "automated_system",
            "external_system",
            "unknown"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string"
        },
        "ai": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "tool": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "session_id": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}