{
  "required": [
    "specforge",
    "project",
    "specification",
    "paths",
    "policy"
  ],
  "properties": {
    "specforge": {
      "type": "object",
      "required": [
        "core_version",
        "data_model_version"
      ],
      "properties": {
        "core_version": {
          "type": "string"
        },
        "data_model_version": {
          "type": "string"
        }
      }
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^PRJ-[0-9]{4,}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "specification": {
      "type": "object",
      "required": [
        "root",
        "current_version"
      ],
      "properties": {
        "root": {
          "type": "string"
        },
        "current_version": {
          "type": "string"
        },
        "product_specification": {
          "type": "string"
        },
        "canonical_data_model": {
          "type": "string"
        }
      }
    },
    "paths": {
      "type": "object"
    },
    "domains": {
      "type": "array"
    },
    "policy": {
      "type": "object",
      "properties": {
        "approval_mode": {
          "enum": [
            "controlled",
            "trusted",
            "advisory"
          ]
        },
        "emergency_changes": {
          "type": "boolean"
        },
        "trivial_change_exemption": {
          "type": "boolean"
        },
        "forensic_traceability": {
          "type": "boolean"
        },
        "repository_completeness": {
          "type": "boolean"
        }
      }
    }
  },
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "specforge",
  "type": "object",
  "$defs": {
    "actor": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "human",
            "ai",
            "automated_system",
            "external_system",
            "unknown"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string"
        },
        "ai": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "tool": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "session_id": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}