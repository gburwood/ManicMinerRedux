{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "checkpoint-acceptance",
  "type": "object",
  "required": [
    "id",
    "checkpoint",
    "decision",
    "candidate",
    "included_changes_digest",
    "actor",
    "timestamp",
    "mechanism"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ACC-[0-9]{4,}$"
    },
    "checkpoint": {
      "type": "string",
      "pattern": "^CHK-[0-9]{4,}$"
    },
    "decision": {
      "enum": [
        "accepted",
        "rejected",
        "withdrawn"
      ]
    },
    "candidate": {
      "type": "object",
      "required": [
        "material"
      ],
      "properties": {
        "material": {
          "type": "object",
          "required": [
            "provider",
            "revision"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "pattern": "^sha256:[0-9a-fA-F]{64}$"
            },
            "file_count": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "included_changes_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "actor": {
      "$ref": "#/$defs/actor"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "mechanism": {
      "type": "object",
      "required": [
        "type",
        "reference"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object"
    },
    "authority": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "prospective_exact_candidate_v1",
            "direct_checkpoint_acceptance_v1"
          ]
        },
        "source": {
          "type": "string",
          "pattern": "^(?:PFA|CAP)-[0-9]{4,}$"
        },
        "principal": {
          "$ref": "#/$defs/actor"
        },
        "granted_at": {
          "type": "string",
          "format": "date-time"
        },
        "presentation": {
          "type": "string"
        },
        "session": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "actor": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "human",
            "ai",
            "automated_system",
            "external_system",
            "unknown"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string"
        },
        "ai": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  }
}
