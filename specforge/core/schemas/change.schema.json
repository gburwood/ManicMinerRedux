{
  "required": [
    "id",
    "title",
    "classification",
    "status",
    "sources",
    "request"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CHG-[0-9]{4,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "description": "Canonical change classification. experiment denotes intentionally governed experimental or validation work and grants no exemption from approval, evidence, governance-tier, implementation, validation or checkpoint controls.",
      "enum": [
        "feature",
        "behaviour_change",
        "defect",
        "specification_defect",
        "refactor",
        "documentation",
        "tooling_infrastructure",
        "unknown",
        "experiment"
      ]
    },
    "status": {
      "enum": [
        "intake",
        "proposed",
        "needs_clarification",
        "analysed",
        "awaiting_approval",
        "approved",
        "in_progress",
        "implemented",
        "validated",
        "ready_for_checkpoint",
        "completed",
        "rejected",
        "deferred",
        "cancelled"
      ]
    },
    "priority": {
      "enum": [
        "critical",
        "high",
        "normal",
        "low",
        "unspecified"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "request": {
      "type": "object",
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "clarification": {
      "type": "object"
    },
    "relationships": {
      "type": "object"
    },
    "impact_analysis": {
      "type": "object"
    },
    "proposal": {
      "type": "object"
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^APR-[0-9]{4,}$"
      }
    },
    "implementation": {
      "type": "object"
    },
    "requirements": {
      "type": "object"
    },
    "release": {
      "type": "object"
    },
    "workflow": {
      "type": "object"
    },
    "override": {
      "type": "object"
    },
    "reconciliation": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    },
    "extensions": {
      "type": "object"
    },
    "governance": {
      "type": "object",
      "properties": {
        "lifecycle_enforcement": {
          "enum": [
            "controlled_v1",
            "controlled_v2",
            "controlled_v3"
          ]
        },
        "enforced_from_change": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "change",
  "type": "object",
  "$defs": {
    "actor": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "human",
            "ai",
            "automated_system",
            "external_system",
            "unknown"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string"
        },
        "ai": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "tool": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "session_id": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
