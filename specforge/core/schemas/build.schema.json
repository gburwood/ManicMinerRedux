{
  "required": [
    "id",
    "source_revision",
    "specification_version",
    "result"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^BLD-[0-9]{4,}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source_revision": {
      "type": "object"
    },
    "specification_version": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CHG-[0-9]{4,}$"
      }
    },
    "build_system": {
      "type": "object"
    },
    "configuration": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "result": {
      "enum": [
        "passed",
        "failed",
        "partial"
      ]
    }
  },
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "build",
  "type": "object",
  "$defs": {
    "actor": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "human",
            "ai",
            "automated_system",
            "external_system",
            "unknown"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string"
        },
        "ai": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "tool": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "session_id": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}