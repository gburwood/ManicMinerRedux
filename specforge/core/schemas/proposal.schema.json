{
  "required": [
    "id",
    "change",
    "revision",
    "status",
    "behaviour_summary"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^PROP-[0-9]{4,}-[0-9]{2,}$"
    },
    "change": {
      "type": "string",
      "pattern": "^CHG-[0-9]{4,}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "awaiting_approval",
        "approved",
        "rejected",
        "superseded",
        "withdrawn"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "based_on_impact_analysis": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^IA-[0-9]{4,}-[0-9]{2,}$"
      }
    },
    "proposed_specification_version": {
      "type": "string"
    },
    "requirement_changes": {
      "type": "object"
    },
    "governance_tier": {
      "type": "object",
      "properties": {
        "requested": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "calculated_minimum": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        }
      },
      "additionalProperties": true
    },
    "declared_scope": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "operation"
        ],
        "properties": {
          "operation": {
            "enum": [
              "add",
              "modify",
              "delete",
              "rename",
              "copy"
            ]
          },
          "path": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "behaviour_summary": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "object"
    },
    "artifacts_expected": {
      "type": "object"
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^APR-[0-9]{4,}$"
      }
    },
    "exact_candidate_finalisation": {
      "type": "object",
      "required": [
        "eligible",
        "prepared_artifacts",
        "deletions"
      ],
      "properties": {
        "eligible": {
          "type": "boolean"
        },
        "prepared_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          }
        },
        "deletions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "project_definition_reconciliation": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "request_digest",
        "change"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "request_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "change": {
          "type": "string",
          "pattern": "^CHG-[0-9]{4,}$"
        },
        "mode": {
          "enum": [
            "context_only",
            "durable_update"
          ]
        },
        "definition_format_version": {
          "type": "integer",
          "const": 2
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "proposal",
  "type": "object",
  "$defs": {
    "actor": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "human",
            "ai",
            "automated_system",
            "external_system",
            "unknown"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string"
        },
        "ai": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "tool": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "session_id": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
