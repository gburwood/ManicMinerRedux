{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "assurance-profile",
  "type": "object",
  "required": ["id", "version", "requirements"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "version": {"type": "string", "minLength": 1},
    "requirements": {
      "type": "object",
      "properties": {
        "validation": {"type": "object", "properties": {"required": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false},
        "acceptance": {"type": "object", "properties": {"required": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
