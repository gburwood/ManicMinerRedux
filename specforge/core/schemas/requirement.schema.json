{
  "required": [
    "id",
    "title",
    "status",
    "requirement",
    "introduced"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^REQ-[0-9]{4,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "proposed",
        "active",
        "deprecated",
        "superseded",
        "withdrawn"
      ]
    },
    "requirement": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string"
    },
    "introduced": {
      "type": "object",
      "required": [
        "by_change",
        "in_specification"
      ],
      "properties": {
        "by_change": {
          "type": "string",
          "pattern": "^CHG-[0-9]{4,}$"
        },
        "in_specification": {
          "type": "string"
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^AC-[0-9]{4,}-[0-9]{2,}$"
      },
      "uniqueItems": true
    },
    "relationships": {
      "type": "object"
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "requirement",
  "type": "object",
  "$defs": {
    "actor": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "human",
            "ai",
            "automated_system",
            "external_system",
            "unknown"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string"
        },
        "ai": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "tool": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "session_id": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}