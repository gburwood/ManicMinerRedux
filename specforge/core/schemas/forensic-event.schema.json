{
  "required": [
    "id",
    "timestamp",
    "actor",
    "event_type",
    "entity"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^EVT-[0-9]{6,}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "$ref": "#/$defs/actor"
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "entity": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      }
    },
    "related": {
      "type": "object"
    },
    "previous_state": {
      "type": "object"
    },
    "resulting_state": {
      "type": "object"
    },
    "evidence": {
      "type": "object"
    },
    "corrects": {
      "type": "string",
      "pattern": "^EVT-[0-9]{6,}$"
    }
  },
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "forensic-event",
  "type": "object",
  "$defs": {
    "actor": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "human",
            "ai",
            "automated_system",
            "external_system",
            "unknown"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string"
        },
        "ai": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "tool": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "session_id": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}