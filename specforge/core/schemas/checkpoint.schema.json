{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "checkpoint",
  "type": "object",
  "required": ["id", "status", "included_changes", "candidate", "validation"],
  "properties": {
    "id": {"type": "string", "pattern": "^CHK-[0-9]{4,}$"},
    "title": {"type": "string"},
    "status": {"enum": ["candidate", "under_validation", "accepted", "rejected", "superseded"]},
    "included_changes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^CHG-[0-9]{4,}$"}},
    "included_changes_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "candidate": {"type": "object", "required": ["material"], "properties": {
      "material": {"type": "object", "required": ["provider", "revision"], "properties": {
        "provider": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"},
        "file_count": {"type": "integer", "minimum": 0}
      }, "additionalProperties": true},
      "source_revision": {"type": "object"}
    }, "additionalProperties": true},
    "validation": {"type": "array", "items": {"type": "object", "required": ["requirement", "status"], "properties": {
      "requirement": {"type": "string", "minLength": 1},
      "status": {"enum": ["passed", "failed", "blocked", "unavailable"]},
      "evidence": {}
    }, "additionalProperties": true}},
    "acceptance": {"type": "object", "properties": {"current": {"type": ["string", "null"], "pattern": "^ACC-[0-9]{4,}$"}}, "additionalProperties": true},
    "supersedes": {"type": ["string", "null"], "pattern": "^CHK-[0-9]{4,}$"},
    "metadata": {"type": "object"}
  },
  "additionalProperties": true
}
