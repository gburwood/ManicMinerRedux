{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "implementation-attempt",
  "type": "object",
  "required": [
    "id",
    "change",
    "proposal",
    "attempt",
    "actor",
    "outcome"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^IMP-[0-9]{4,}-[0-9]{2,}$"
    },
    "change": {
      "type": "string",
      "pattern": "^CHG-[0-9]{4,}$"
    },
    "proposal": {
      "type": "string",
      "pattern": "^PROP-[0-9]{4,}-[0-9]{2,}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "$ref": "#/$defs/actor"
    },
    "approach": {
      "type": "string"
    },
    "source_revision": {
      "type": "object",
      "properties": {
        "system": {"type": "string"},
        "provider": {"type": "string"},
        "before": {"type": "string", "minLength": 1},
        "after": {"type": "string", "minLength": 1},
        "material_effects": {"type": "boolean"},
        "verification_profile": {"type": "string"}
      },
      "additionalProperties": true
    },
    "integration": {
      "type": "object",
      "properties": {
        "profile": {"type": "string"},
        "provider": {"type": "string", "minLength": 1},
        "target_ref": {"type": "string", "minLength": 1},
        "target_before": {"type": "string", "minLength": 1},
        "integrated_revision": {"type": "string", "minLength": 1},
        "implementation_material": {"$ref": "#/$defs/material_identity"},
        "integrated_material": {"$ref": "#/$defs/material_identity"},
        "verification": {
          "type": "object",
          "properties": {
            "status": {"enum": ["passed", "failed", "blocked", "unavailable"]},
            "method": {"type": "string"},
            "checked_at": {"type": "string", "format": "date-time"}
          },
          "additionalProperties": true
        }
      },
      "required": ["profile", "provider", "integrated_revision", "implementation_material", "integrated_material"],
      "additionalProperties": true
    },
    "outcome": {
      "enum": ["in_progress", "passed", "failed", "blocked", "unavailable", "abandoned", "superseded"]
    },
    "governance_tier": {
      "type": "object",
      "properties": {
        "actual": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "effective_actual": {"enum": ["LOW", "MEDIUM", "HIGH"]}
      },
      "additionalProperties": true
    },
    "validation": {
      "type": "array",
      "items": {"type": "string", "pattern": "^VAL-[0-9]{4,}$"}
    },
    "tests": {"type": "object"},
    "failure": {"type": "object"},
    "notes": {"type": "string"},
    "validation_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "required", "status"],
        "properties": {
          "name": {"type": "string"},
          "required": {"type": "boolean"},
          "status": {"enum": ["passed", "failed", "blocked", "unavailable"]},
          "evidence": {}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "material_identity": {
      "type": "object",
      "required": ["provider", "revision"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"},
        "file_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "actor": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {"enum": ["human", "ai", "automated_system", "external_system", "unknown"]},
        "id": {"type": "string", "minLength": 1},
        "display_name": {"type": "string"},
        "ai": {
          "type": "object",
          "properties": {
            "provider": {"type": "string"},
            "tool": {"type": "string"},
            "model": {"type": "string"},
            "session_id": {"type": "string"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
